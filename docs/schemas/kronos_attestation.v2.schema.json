{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronos.local/schemas/kronos_attestation.v2.schema.json",
  "title": "Kronos Signed Attestation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "statement", "signature"],
  "properties": {"schema": {"const": "kronos_attestation.v2"}, "statement": {"$ref": "#/$defs/statement"}, "signature": {"$ref": "#/$defs/signature"}},
  "$defs": {
    "sha256": {"$ref": "kronos_gjc_authority.v2.schema.json#/$defs/sha256"}, "uuid": {"$ref": "kronos_gjc_authority.v2.schema.json#/$defs/uuid"}, "utc": {"$ref": "kronos_gjc_authority.v2.schema.json#/$defs/utc"}, "safeInt": {"$ref": "kronos_gjc_authority.v2.schema.json#/$defs/safeInt"}, "principalUri": {"$ref": "kronos_gjc_authority.v2.schema.json#/$defs/principalUri"}, "keyId": {"$ref": "kronos_gjc_authority.v2.schema.json#/$defs/keyId"}, "role": {"$ref": "kronos_gjc_authority.v2.schema.json#/$defs/role"}, "purpose": {"$ref": "kronos_gjc_authority.v2.schema.json#/$defs/purpose"}, "signature": {"$ref": "kronos_gjc_authority.v2.schema.json#/$defs/base64url64"}, "nonce": {"$ref": "kronos_gjc_authority.v2.schema.json#/$defs/base64url32"},
    "statement": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "attestation_uid", "payload_schema", "payload_sha256", "payload_byte_length", "signer_principal_uri", "role", "key_id", "algorithm", "signature_encoding", "authority_envelope_sha256", "issued_at", "expires_at", "nonce", "purpose"],
      "properties": {
        "schema": {"const": "kronos_attestation_statement.v2"}, "attestation_uid": {"$ref": "#/$defs/uuid"}, "payload_schema": {"type": "string", "minLength": 1}, "payload_sha256": {"$ref": "#/$defs/sha256"}, "payload_byte_length": {"$ref": "#/$defs/safeInt"}, "signer_principal_uri": {"$ref": "#/$defs/principalUri"}, "role": {"$ref": "#/$defs/role"}, "key_id": {"$ref": "#/$defs/keyId"}, "algorithm": {"const": "Ed25519"}, "signature_encoding": {"const": "base64url-no-pad"}, "authority_envelope_sha256": {"$ref": "#/$defs/sha256"}, "issued_at": {"$ref": "#/$defs/utc"}, "expires_at": {"$ref": "#/$defs/utc"}, "nonce": {"$ref": "#/$defs/nonce"}, "purpose": {"$ref": "#/$defs/purpose"}
      }
    }
  }
}
