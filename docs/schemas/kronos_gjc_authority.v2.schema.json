{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronos.local/schemas/kronos_gjc_authority.v2.schema.json",
  "title": "Kronos GJC Authority v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority"],
  "properties": {
    "schema": {"const": "kronos_gjc_authority.v2"},
    "authority": {"$ref": "#/$defs/authorityGrant"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "safeInt": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "principalUri": {"type": "string", "pattern": "^agent://[^/\\s]+$"},
    "keyId": {"$ref": "#/$defs/uuid"},
    "base64url32": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "base64url64": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "role": {"enum": ["ORCHESTRATOR", "USABILITY_OPERATOR", "TASK_SCORE_REVIEWER", "ARCHITECT_REVIEWER", "CRITIC_REVIEWER", "EXECUTOR_QA_REVIEWER", "TERMINAL_CLOSURE_AUTHORITY", "D0_ISSUER", "D0_REVIEWER", "D1_ISSUER", "D1_REVIEWER", "OOS_CUSTODIAN", "OOS_EVALUATOR"]},
    "scope": {"enum": ["AUTHORITY_LIFECYCLE", "OPERATOR_A", "OPERATOR_B", "TASK_SCORE", "ARCHITECT_REVIEW", "CRITIC_REVIEW", "EXECUTOR_QA", "TERMINAL_CLOSURE", "D0_EVIDENCE", "D1_EVIDENCE", "OOS_CUSTODY", "OOS_CAPABILITY", "OOS_RELEASE", "OOS_EVALUATION"]},
    "purpose": {"enum": ["AUTHORITY_LIFECYCLE", "GJC_ASSIGNMENT", "GJC_ROLE_OUTPUT", "D0_EVIDENCE", "D1_EVIDENCE", "OOS_CUSTODY", "OOS_CAPABILITY", "OOS_RELEASE", "OOS_EVALUATION"]},
    "authorityGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "scope", "purpose"],
      "properties": {"role": {"$ref": "#/$defs/role"}, "scope": {"$ref": "#/$defs/scope"}, "purpose": {"$ref": "#/$defs/purpose"}},
      "oneOf": [
        {"properties": {"role": {"const": "ORCHESTRATOR"}, "scope": {"const": "AUTHORITY_LIFECYCLE"}, "purpose": {"const": "AUTHORITY_LIFECYCLE"}}},
        {"properties": {"role": {"const": "ORCHESTRATOR"}, "scope": {"enum": ["OPERATOR_A", "OPERATOR_B", "TASK_SCORE", "ARCHITECT_REVIEW", "CRITIC_REVIEW", "EXECUTOR_QA", "TERMINAL_CLOSURE"]}, "purpose": {"const": "GJC_ASSIGNMENT"}}},
        {"properties": {"role": {"const": "USABILITY_OPERATOR"}, "scope": {"enum": ["OPERATOR_A", "OPERATOR_B"]}, "purpose": {"const": "GJC_ROLE_OUTPUT"}}},
        {"properties": {"role": {"const": "TASK_SCORE_REVIEWER"}, "scope": {"const": "TASK_SCORE"}, "purpose": {"const": "GJC_ROLE_OUTPUT"}}},
        {"properties": {"role": {"const": "ARCHITECT_REVIEWER"}, "scope": {"const": "ARCHITECT_REVIEW"}, "purpose": {"const": "GJC_ROLE_OUTPUT"}}},
        {"properties": {"role": {"const": "CRITIC_REVIEWER"}, "scope": {"const": "CRITIC_REVIEW"}, "purpose": {"const": "GJC_ROLE_OUTPUT"}}},
        {"properties": {"role": {"const": "EXECUTOR_QA_REVIEWER"}, "scope": {"const": "EXECUTOR_QA"}, "purpose": {"const": "GJC_ROLE_OUTPUT"}}},
        {"properties": {"role": {"const": "TERMINAL_CLOSURE_AUTHORITY"}, "scope": {"const": "TERMINAL_CLOSURE"}, "purpose": {"const": "GJC_ROLE_OUTPUT"}}},
        {"properties": {"role": {"enum": ["D0_ISSUER", "D0_REVIEWER"]}, "scope": {"const": "D0_EVIDENCE"}, "purpose": {"const": "D0_EVIDENCE"}}},
        {"properties": {"role": {"enum": ["D1_ISSUER", "D1_REVIEWER"]}, "scope": {"const": "D1_EVIDENCE"}, "purpose": {"const": "D1_EVIDENCE"}}},
        {"properties": {"role": {"const": "OOS_CUSTODIAN"}, "scope": {"const": "OOS_CUSTODY"}, "purpose": {"const": "OOS_CUSTODY"}}},
        {"properties": {"role": {"const": "OOS_CUSTODIAN"}, "scope": {"const": "OOS_CAPABILITY"}, "purpose": {"const": "OOS_CAPABILITY"}}},
        {"properties": {"role": {"const": "OOS_CUSTODIAN"}, "scope": {"const": "OOS_RELEASE"}, "purpose": {"const": "OOS_RELEASE"}}},
        {"properties": {"role": {"const": "OOS_EVALUATOR"}, "scope": {"const": "OOS_EVALUATION"}, "purpose": {"const": "OOS_EVALUATION"}}}
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key_encoding", "public_key", "status", "not_before", "not_after", "revoked_at", "revocation_reason"],
      "properties": {
        "key_id": {"$ref": "#/$defs/keyId"}, "algorithm": {"const": "Ed25519"}, "public_key_encoding": {"const": "base64url-no-pad"}, "public_key": {"$ref": "#/$defs/base64url32"},
        "status": {"enum": ["ACTIVE", "SUSPENDED", "REVOKED"]}, "not_before": {"$ref": "#/$defs/utc"}, "not_after": {"$ref": "#/$defs/utc"},
        "revoked_at": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]}, "revocation_reason": {"anyOf": [{"enum": ["COMPROMISE", "ROTATION", "ROLE_REMOVED", "ADMINISTRATIVE"]}, {"type": "null"}]}
      }
    },
    "principal": {
      "type": "object", "additionalProperties": false,
      "required": ["principal_uri", "roles", "scopes", "status", "keys"],
      "properties": {"principal_uri": {"$ref": "#/$defs/principalUri"}, "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/role"}}, "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scope"}}, "status": {"enum": ["ACTIVE", "SUSPENDED", "REVOKED"]}, "keys": {"type": "array", "description": "Key IDs must be nonempty, unique, and lexical ascending; enforced by the authority verifier because JSON Schema cannot order object members by a nested property.", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}}
    }
  }
}
