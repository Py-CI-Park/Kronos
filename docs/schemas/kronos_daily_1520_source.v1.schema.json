{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronos.local/schemas/kronos_daily_1520_source.v1.schema.json",
  "title": "Kronos Daily 15:20 Source v1",
  "description": "Executable contract for exact 15:20 KST 5-minute bar-close proxy source artifacts. The artifact mirrors build_source_coverage() and includes Daily1520SourceRow.as_dict() rows; it is not an official close and permits no nearest-bar, daily OHLCV, cumulative-volume, or price*volume amount fallback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_db_path",
    "source_snapshot",
    "source_db_sha256",
    "source_hash_basis",
    "read_only",
    "query_only",
    "causal_cutoff_kst",
    "price_basis",
    "official_close",
    "source_calendar",
    "first_valid_date",
    "last_valid_date",
    "exact_1520_row_count",
    "missing_1520_date_count",
    "missing_date_policy",
    "missing_rows_synthesized",
    "false_research_locks",
    "six_locks_false",
    "no_claim_flags",
    "tables",
    "rows"
  ],
  "properties": {
    "schema_version": {"const": "kronos_daily_1520_source.v1"},
    "source_db_path": {"$ref": "#/$defs/sourcePath"},
    "source_snapshot": {"$ref": "#/$defs/sourceSnapshot"},
    "source_db_sha256": {"$ref": "#/$defs/sha256"},
    "source_hash_basis": {"const": "ACTUAL_FILE_BYTES_STREAMING_SHA256"},
    "read_only": {"const": true},
    "query_only": {"const": true},
    "causal_cutoff_kst": {"const": "15:20:00"},
    "price_basis": {"const": "15:20_bar_close_proxy"},
    "official_close": {"const": false},
    "source_calendar": {
      "type": "array",
      "items": {"$ref": "#/$defs/date"},
      "uniqueItems": true
    },
    "first_valid_date": {"$ref": "#/$defs/nullableDate"},
    "last_valid_date": {"$ref": "#/$defs/nullableDate"},
    "exact_1520_row_count": {"$ref": "#/$defs/safeInt"},
    "missing_1520_date_count": {"$ref": "#/$defs/safeInt"},
    "missing_date_policy": {"const": "Expected dates are each table's own observed valid intraday source calendar within the requested range; missing dates are explicit and source rows are never synthesized."},
    "missing_rows_synthesized": {"const": false},
    "false_research_locks": {"$ref": "#/$defs/falseResearchLocks"},
    "six_locks_false": {"$ref": "#/$defs/falseResearchLocks"},
    "no_claim_flags": {"$ref": "#/$defs/noClaimFlags"},
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tableCoverage"}
    },
    "rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceRow"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "nullableDate": {
      "oneOf": [
        {"$ref": "#/$defs/date"},
        {"type": "null"}
      ]
    },
    "timestamp1520": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T15:20:00\\+09:00$"
    },
    "compactTimestamp1520": {
      "type": "string",
      "pattern": "^\\d{8}1520$",
      "description": "JSON artifact string YYYYMMDD1520 compact timestamp for the exact 15:20 KST bar."
    },
    "sourcePath": {
      "type": "string",
      "pattern": "(?:^|[\\\\/])_database[\\\\/]Stock_Database_ohlcv_5min\\.db$"
    },
    "symbol": {"type": "string", "pattern": "^[0-9]{6}$"},
    "sourceTable": {"type": "string", "pattern": "^A[0-9]{6}$"},
    "safeInt": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "finiteNumber": {"type": "number"},
    "nonNegativeNumber": {"type": "number", "minimum": 0, "maximum": 9007199254740991},
    "sourceColumns": {
      "type": "array",
      "prefixItems": [
        {"const": "date"},
        {"const": "open"},
        {"const": "high"},
        {"const": "low"},
        {"const": "close"},
        {"const": "volume"}
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_length", "hash_basis"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"$ref": "#/$defs/safeInt"},
        "hash_basis": {"const": "ACTUAL_FILE_BYTES_STREAMING_SHA256"}
      }
    },
    "falseResearchLocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_allowed",
        "model_build_allowed",
        "paper_forward_allowed",
        "live_broker_order_allowed",
        "profitability_claim_allowed",
        "go_summary_allowed"
      ],
      "properties": {
        "promotion_allowed": {"const": false},
        "model_build_allowed": {"const": false},
        "paper_forward_allowed": {"const": false},
        "live_broker_order_allowed": {"const": false},
        "profitability_claim_allowed": {"const": false},
        "go_summary_allowed": {"const": false}
      }
    },
    "noClaimFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_close_claim",
        "daily_ohlcv_fallback_claim",
        "nearest_bar_fallback_claim",
        "paper_forward_claim",
        "live_broker_order_claim",
        "profitability_claim"
      ],
      "properties": {
        "official_close_claim": {"const": false},
        "daily_ohlcv_fallback_claim": {"const": false},
        "nearest_bar_fallback_claim": {"const": false},
        "paper_forward_claim": {"const": false},
        "live_broker_order_claim": {"const": false},
        "profitability_claim": {"const": false}
      }
    },
    "tableCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "symbol",
        "table",
        "source_columns",
        "first_valid_date",
        "last_valid_date",
        "exact_1520_row_count",
        "valid_session_count",
        "duplicate_1520_date_count",
        "expected_session_count",
        "missing_1520_date_count",
        "missing_dates",
        "missing_exclusion_reason",
        "missing_rows_synthesized",
        "tradable_when_missing"
      ],
      "properties": {
        "requested": {"type": "string", "minLength": 1},
        "symbol": {"$ref": "#/$defs/symbol"},
        "table": {"$ref": "#/$defs/sourceTable"},
        "source_columns": {"$ref": "#/$defs/sourceColumns"},
        "first_valid_date": {"$ref": "#/$defs/nullableDate"},
        "last_valid_date": {"$ref": "#/$defs/nullableDate"},
        "exact_1520_row_count": {"$ref": "#/$defs/safeInt"},
        "valid_session_count": {"$ref": "#/$defs/safeInt"},
        "duplicate_1520_date_count": {"$ref": "#/$defs/safeInt"},
        "expected_session_count": {"$ref": "#/$defs/safeInt"},
        "missing_1520_date_count": {"$ref": "#/$defs/safeInt"},
        "missing_dates": {
          "type": "array",
          "items": {"$ref": "#/$defs/date"}
        },
        "missing_exclusion_reason": {"const": "MISSING_1520_BAR"},
        "missing_rows_synthesized": {"const": false},
        "tradable_when_missing": {"const": false}
      }
    },
    "sourceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "session_date",
        "date",
        "timestamp_kst",
        "timestamp_yyyymmddhhmm",
        "symbol",
        "table",
        "open",
        "high",
        "low",
        "close",
        "price_1520_close_proxy",
        "bar_volume_1520",
        "bar_volume_status",
        "volume_to_1520",
        "volume_to_1520_status",
        "cumulative_volume_to_1520",
        "cumulative_volume_to_1520_status",
        "amount_to_1520",
        "amount_to_1520_status",
        "tradable",
        "exclusion_reason",
        "official_close",
        "price_basis",
        "causal_cutoff_kst",
        "source_db_path",
        "source_table",
        "source_columns",
        "source_timestamp_column",
        "source_price_column",
        "source_volume_column"
      ],
      "properties": {
        "schema_version": {"const": "kronos_daily_1520_source.v1"},
        "session_date": {"$ref": "#/$defs/date"},
        "date": {"$ref": "#/$defs/date"},
        "timestamp_kst": {"$ref": "#/$defs/timestamp1520"},
        "timestamp_yyyymmddhhmm": {"$ref": "#/$defs/compactTimestamp1520"},
        "symbol": {"$ref": "#/$defs/symbol"},
        "table": {"$ref": "#/$defs/sourceTable"},
        "open": {"$ref": "#/$defs/finiteNumber"},
        "high": {"$ref": "#/$defs/finiteNumber"},
        "low": {"$ref": "#/$defs/finiteNumber"},
        "close": {"$ref": "#/$defs/finiteNumber"},
        "price_1520_close_proxy": {"$ref": "#/$defs/finiteNumber"},
        "bar_volume_1520": {"$ref": "#/$defs/nonNegativeNumber"},
        "bar_volume_status": {"const": "SINGLE_5MIN_BAR_VOLUME_AT_15_20_ONLY"},
        "volume_to_1520": {"type": "null"},
        "volume_to_1520_status": {"const": "NOT_AVAILABLE_SOURCE_HAS_SINGLE_5MIN_BAR_VOLUME_ONLY"},
        "cumulative_volume_to_1520": {"type": "null"},
        "cumulative_volume_to_1520_status": {"const": "NOT_AVAILABLE_SOURCE_HAS_SINGLE_5MIN_BAR_VOLUME_ONLY"},
        "amount_to_1520": {"type": "null"},
        "amount_to_1520_status": {"const": "NOT_AVAILABLE_5MIN_DB_HAS_NO_AMOUNT_COLUMN_DO_NOT_APPROXIMATE_PRICE_X_VOLUME"},
        "tradable": {"const": true},
        "exclusion_reason": {"type": "null"},
        "official_close": {"const": false},
        "price_basis": {"const": "15:20_bar_close_proxy"},
        "causal_cutoff_kst": {"const": "15:20:00"},
        "source_db_path": {"$ref": "#/$defs/sourcePath"},
        "source_table": {"$ref": "#/$defs/sourceTable"},
        "source_columns": {"$ref": "#/$defs/sourceColumns"},
        "source_timestamp_column": {"const": "date"},
        "source_price_column": {"const": "close"},
        "source_volume_column": {"const": "volume"}
      }
    }
  }
}
