{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kronos.local/schemas/kronos_v5_release_closure.v1.schema.json",
  "title": "Kronos V5 release closure local orchestrator contracts",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "byte_length", "schema"],
      "properties": {
        "uri": {"type": "string", "pattern": "^agent://[^/\\s]+/.+"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0},
        "schema": {"type": "string", "minLength": 1}
      }
    },
    "nullableRef": {
      "anyOf": [
        {"$ref": "#/$defs/ref"},
        {"type": "null"}
      ]
    },
    "phase": {
      "enum": [
        "BIND_HEAD",
        "PREFLIGHT",
        "QA",
        "GENERIC_CAPTURE",
        "OPERATOR_A",
        "OPERATOR_B",
        "TASK_SCORE",
        "EVIDENCE",
        "PRECLOSURE",
        "ASSURANCE",
        "FINAL_MAP",
        "SCORE_A",
        "SCORE_B",
        "TERMINAL"
      ]
    },
    "terminalStatus": {
      "enum": ["ACTIVE", "INVALIDATED", "TERMINAL_BLOCKED", "TERMINAL_CLOSED"]
    },
    "blocker": {
      "enum": [
        "POINT_SCORE_MISMATCH",
        "POINT_SCORE_FAIL",
        "ASSURANCE_BLOCK",
        "PRIOR_CHAIN_RERESOLUTION_FAIL",
        "HEAD_DRIFT",
        "TREE_DRIFT",
        "DIST_DRIFT",
        "CONFIG_DRIFT",
        "DIRTY_WORKTREE",
        "SOURCE_IDENTITY_MISMATCH",
        "ROLLBACK_UNAVAILABLE",
        "ROLLBACK_QUERY_FAIL",
        "BROWSER_EVIDENCE_NOT_LIVE",
        "BROWSER_EVIDENCE_SYNTHETIC",
        "BROWSER_EVIDENCE_REUSED",
        "BROWSER_MATRIX_FAIL",
        "SECURITY_GATE_FAIL",
        "PUBLICATION_ACTION_FORBIDDEN",
        "LOCK_INVARIANT_FAIL",
        "DRY_RUN_FIXTURE_NOT_RELEASABLE"
      ]
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/blocker"}
    },
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_allowed",
        "model_build_allowed",
        "paper_forward_allowed",
        "live_broker_order_allowed",
        "profitability_claim_allowed",
        "go_summary_allowed"
      ],
      "properties": {
        "promotion_allowed": {"const": false},
        "model_build_allowed": {"const": false},
        "paper_forward_allowed": {"const": false},
        "live_broker_order_allowed": {"const": false},
        "profitability_claim_allowed": {"const": false},
        "go_summary_allowed": {"const": false}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_sha256", "tree_sha256", "dist_manifest_sha256", "config_sha256"],
      "properties": {
        "head_sha256": {"$ref": "#/$defs/sha256"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "dist_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "equationTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_closed",
        "point_score_a_eq_b",
        "engineering_90_pass",
        "assurance_eligible",
        "prior_chains_resolved",
        "head_match",
        "tree_match",
        "dist_match",
        "config_match",
        "worktree_clean",
        "source_identity_bound",
        "rollback_v3_available",
        "rollback_query_pass",
        "live_browser_distinct",
        "security_clear",
        "six_locks_false",
        "no_publication_action",
        "not_dry_run_fixture"
      ],
      "properties": {
        "release_closed": {"type": "boolean"},
        "point_score_a_eq_b": {"type": "boolean"},
        "engineering_90_pass": {"type": "boolean"},
        "assurance_eligible": {"type": "boolean"},
        "prior_chains_resolved": {"type": "boolean"},
        "head_match": {"type": "boolean"},
        "tree_match": {"type": "boolean"},
        "dist_match": {"type": "boolean"},
        "config_match": {"type": "boolean"},
        "worktree_clean": {"type": "boolean"},
        "source_identity_bound": {"type": "boolean"},
        "rollback_v3_available": {"type": "boolean"},
        "rollback_query_pass": {"type": "boolean"},
        "live_browser_distinct": {"type": "boolean"},
        "security_clear": {"type": "boolean"},
        "six_locks_false": {"type": "boolean"},
        "no_publication_action": {"type": "boolean"},
        "not_dry_run_fixture": {"type": "boolean"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema", "default_equation", "release_eligible", "default_eligible", "default_decision", "terminal_result", "blocking_codes", "equation_terms", "six_locks_false"],
      "properties": {
        "schema": {"const": "kronos_v5_default_gate.v1"},
        "default_equation": {"const": "V5_DEFAULT := RELEASE_CLOSED && POINT_SCORE_A_EQ_B && ENGINEERING_90_PASS && ASSURANCE_ELIGIBLE && PRIOR_CHAINS_RESOLVED && HEAD_MATCH && TREE_MATCH && DIST_MATCH && CONFIG_MATCH && WORKTREE_CLEAN && SOURCE_IDENTITY_BOUND && ROLLBACK_V3_AVAILABLE && ROLLBACK_QUERY_PASS && LIVE_BROWSER_DISTINCT && SECURITY_CLEAR && SIX_LOCKS_FALSE && NO_PUBLICATION_ACTION && !DRY_RUN_FIXTURE"},
        "release_eligible": {"type": "boolean"},
        "default_eligible": {"type": "boolean"},
        "default_decision": {"enum": ["SWITCH_TO_V5", "RETAIN_V3"]},
        "terminal_result": {"enum": ["CLOSED", "BLOCKED"]},
        "blocking_codes": {"$ref": "#/$defs/blockers"},
        "equation_terms": {"$ref": "#/$defs/equationTerms"},
        "six_locks_false": {"$ref": "#/$defs/locks"}
      },
      "allOf": [
        {"if": {"properties": {"default_eligible": {"const": true}}}, "then": {"properties": {"release_eligible": {"const": true}, "default_decision": {"const": "SWITCH_TO_V5"}, "terminal_result": {"const": "CLOSED"}, "blocking_codes": {"maxItems": 0}}}},
        {"if": {"properties": {"default_eligible": {"const": false}}}, "then": {"properties": {"default_decision": {"const": "RETAIN_V3"}, "terminal_result": {"const": "BLOCKED"}}}}
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "run_nonce", "phase", "status", "phase_machine", "phases_completed", "bound_identity", "dry_run_fixture_mode", "publication_actions_attempted", "last_successful_artifact_ref", "terminal_report_ref", "invalidation_ref", "immutable", "created_at", "updated_at"],
      "properties": {
        "schema": {"const": "kronos_release_closure_state.v1"},
        "run_nonce": {"type": "string", "minLength": 1},
        "phase": {"$ref": "#/$defs/phase"},
        "status": {"$ref": "#/$defs/terminalStatus"},
        "phase_machine": {"type": "array", "prefixItems": [{"const": "BIND_HEAD"}, {"const": "PREFLIGHT"}, {"const": "QA"}, {"const": "GENERIC_CAPTURE"}, {"const": "OPERATOR_A"}, {"const": "OPERATOR_B"}, {"const": "TASK_SCORE"}, {"const": "EVIDENCE"}, {"const": "PRECLOSURE"}, {"const": "ASSURANCE"}, {"const": "FINAL_MAP"}, {"const": "SCORE_A"}, {"const": "SCORE_B"}, {"const": "TERMINAL"}], "items": false, "minItems": 14, "maxItems": 14},
        "phases_completed": {"type": "array", "items": {"$ref": "#/$defs/phase"}, "uniqueItems": true},
        "bound_identity": {"$ref": "#/$defs/identity"},
        "dry_run_fixture_mode": {"type": "boolean"},
        "publication_actions_attempted": {"const": false},
        "last_successful_artifact_ref": {"$ref": "#/$defs/nullableRef"},
        "terminal_report_ref": {"$ref": "#/$defs/nullableRef"},
        "invalidation_ref": {"$ref": "#/$defs/nullableRef"},
        "immutable": {"type": "boolean"},
        "created_at": {"$ref": "#/$defs/utc"},
        "updated_at": {"$ref": "#/$defs/utc"}
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "run_nonce", "terminal_status", "default_gate", "default_decision", "release_eligible", "default_eligible", "blocking_codes", "bound_identity", "publication_actions_attempted", "mutated_tracked_files", "completed_at"],
      "properties": {
        "schema": {"const": "kronos_release_terminal_report.v1"},
        "run_nonce": {"type": "string", "minLength": 1},
        "terminal_status": {"enum": ["TERMINAL_BLOCKED", "TERMINAL_CLOSED"]},
        "default_gate": {"$ref": "#/$defs/gate"},
        "default_decision": {"enum": ["SWITCH_TO_V5", "RETAIN_V3"]},
        "release_eligible": {"type": "boolean"},
        "default_eligible": {"type": "boolean"},
        "blocking_codes": {"$ref": "#/$defs/blockers"},
        "bound_identity": {"$ref": "#/$defs/identity"},
        "publication_actions_attempted": {"const": false},
        "mutated_tracked_files": {"const": false},
        "completed_at": {"$ref": "#/$defs/utc"}
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "contract_id", "phase_machine", "terminal_statuses", "default_equation", "gate_terms", "blocking_codes", "six_locks_false", "source_inputs", "dist_inputs", "head_inputs", "rollback_inputs", "browser_inputs", "security_inputs", "worktree_policy", "pointer_lifecycle", "subprocess_policy", "claims"],
      "properties": {
        "schema": {"const": "kronos_dashboard_v5_release_closure.v1"},
        "contract_id": {"const": "G010-conditional-default-and-local-closure"},
        "phase_machine": {"$ref": "#/$defs/state/properties/phase_machine"},
        "terminal_statuses": {"const": ["ACTIVE", "INVALIDATED", "TERMINAL_BLOCKED", "TERMINAL_CLOSED"]},
        "default_equation": {"const": "V5_DEFAULT := RELEASE_CLOSED && POINT_SCORE_A_EQ_B && ENGINEERING_90_PASS && ASSURANCE_ELIGIBLE && PRIOR_CHAINS_RESOLVED && HEAD_MATCH && TREE_MATCH && DIST_MATCH && CONFIG_MATCH && WORKTREE_CLEAN && SOURCE_IDENTITY_BOUND && ROLLBACK_V3_AVAILABLE && ROLLBACK_QUERY_PASS && LIVE_BROWSER_DISTINCT && SECURITY_CLEAR && SIX_LOCKS_FALSE && NO_PUBLICATION_ACTION && !DRY_RUN_FIXTURE"},
        "gate_terms": {"const": ["release_closed", "point_score_a_eq_b", "engineering_90_pass", "assurance_eligible", "prior_chains_resolved", "head_match", "tree_match", "dist_match", "config_match", "worktree_clean", "source_identity_bound", "rollback_v3_available", "rollback_query_pass", "live_browser_distinct", "security_clear", "six_locks_false", "no_publication_action", "not_dry_run_fixture"]},
        "blocking_codes": {"const": ["POINT_SCORE_MISMATCH", "POINT_SCORE_FAIL", "ASSURANCE_BLOCK", "PRIOR_CHAIN_RERESOLUTION_FAIL", "HEAD_DRIFT", "TREE_DRIFT", "DIST_DRIFT", "CONFIG_DRIFT", "DIRTY_WORKTREE", "SOURCE_IDENTITY_MISMATCH", "ROLLBACK_UNAVAILABLE", "ROLLBACK_QUERY_FAIL", "BROWSER_EVIDENCE_NOT_LIVE", "BROWSER_EVIDENCE_SYNTHETIC", "BROWSER_EVIDENCE_REUSED", "BROWSER_MATRIX_FAIL", "SECURITY_GATE_FAIL", "PUBLICATION_ACTION_FORBIDDEN", "LOCK_INVARIANT_FAIL", "DRY_RUN_FIXTURE_NOT_RELEASABLE"]},
        "six_locks_false": {"$ref": "#/$defs/locks"},
        "source_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "dist_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "head_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rollback_inputs": {"type": "object"},
        "browser_inputs": {"type": "object"},
        "security_inputs": {"type": "object"},
        "worktree_policy": {"type": "object"},
        "pointer_lifecycle": {"type": "object"},
        "subprocess_policy": {"type": "object"},
        "claims": {"type": "object"}
      }
    },
    {"$ref": "#/$defs/gate"},
    {"$ref": "#/$defs/state"},
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "active_run_nonce", "run_root", "state_ref", "status", "phase", "updated_at", "generation"],
      "properties": {
        "schema": {"const": "kronos_release_closure_active_pointer.v1"},
        "active_run_nonce": {"type": "string", "minLength": 1},
        "run_root": {"type": "string", "minLength": 1},
        "state_ref": {"$ref": "#/$defs/ref"},
        "status": {"$ref": "#/$defs/terminalStatus"},
        "phase": {"$ref": "#/$defs/phase"},
        "updated_at": {"$ref": "#/$defs/utc"},
        "generation": {"type": "integer", "minimum": 1}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "generation", "pointer_ref", "active_run_nonce", "status", "phase", "updated_at"],
      "properties": {
        "schema": {"const": "kronos_release_closure_pointer_history.v1"},
        "generation": {"type": "integer", "minimum": 1},
        "pointer_ref": {"$ref": "#/$defs/ref"},
        "active_run_nonce": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/terminalStatus"},
        "phase": {"$ref": "#/$defs/phase"},
        "updated_at": {"$ref": "#/$defs/utc"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "run_nonce", "phase", "status", "capture_kind", "live_browser_execution", "heavy_compute_run", "fresh_oos_accessed", "publication_action_attempted", "completed_at"],
      "properties": {
        "schema": {"const": "kronos_release_phase_receipt.v1"},
        "run_nonce": {"type": "string", "minLength": 1},
        "phase": {"$ref": "#/$defs/phase"},
        "status": {"const": "COMPLETE"},
        "capture_kind": {"type": "string", "minLength": 1},
        "live_browser_execution": {"type": "boolean"},
        "heavy_compute_run": {"const": false},
        "fresh_oos_accessed": {"const": false},
        "publication_action_attempted": {"const": false},
        "completed_at": {"$ref": "#/$defs/utc"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "run_nonce", "blocking_codes", "status", "failed_at"],
      "properties": {
        "schema": {"const": "kronos_release_closure_invalidation.v1"},
        "run_nonce": {"type": "string", "minLength": 1},
        "blocking_codes": {"$ref": "#/$defs/blockers"},
        "status": {"const": "INVALIDATED"},
        "failed_at": {"$ref": "#/$defs/utc"}
      }
    },
    {"$ref": "#/$defs/terminal"},
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "temp_root", "state", "state_ref", "pointer", "terminal", "blocking_codes", "reused_terminal"],
      "properties": {
        "schema": {"const": "kronos_release_closure_result.v1"},
        "temp_root": {"type": "string", "minLength": 1},
        "state": {"$ref": "#/$defs/state"},
        "state_ref": {"$ref": "#/$defs/ref"},
        "pointer": {"type": ["object", "null"]},
        "terminal": {"anyOf": [{"$ref": "#/$defs/terminal"}, {"type": "null"}]},
        "blocking_codes": {"$ref": "#/$defs/blockers"},
        "reused_terminal": {"type": "boolean"}
      }
    }
  ]
}
