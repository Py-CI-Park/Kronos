{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://kronos.local/schemas/kronos_v5_source_identity.v1.schema.json","title":"Kronos V5 authoritative C2 source identity","description":"Schema closes wire shape; semantic validation enforces canonical UTF-8 ordering, NFC, casefold uniqueness, and scope selection.","type":"object","additionalProperties":false,"required":["schema","source_commit","source_tree","scope_manifest_sha256","files"],"properties":{"schema":{"const":"kronos_source_identity.v1"},"source_commit":{"$ref":"#/$defs/gitSha1"},"source_tree":{"$ref":"#/$defs/gitSha1"},"scope_manifest_sha256":{"const":"215c643b8cd6e6ff2a23a2d2eef4c7cf13b1e8da9a0c3796515735563d0d8f78"},"files":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/file"}}},"$defs":{"gitSha1":{"type":"string","pattern":"^[0-9a-f]{40}$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"file":{"type":"object","additionalProperties":false,"required":["path","git_mode","sha256","byte_length"],"properties":{"path":{"type":"string","minLength":1,"pattern":"^(?!/)(?!.*//)(?!.*%)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\u0000-\\u001f\\u007f]).+$"},"git_mode":{"enum":["100644","100755"]},"sha256":{"$ref":"#/$defs/sha256"},"byte_length":{"type":"integer","minimum":0}}}}}
