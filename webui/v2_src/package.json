{
  "name": "kronos-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kronos official dashboard",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14",
    "node": "^20.19 || ^22.12",
    "npm": "^9 || ^10 || ^11"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:v5-api-generated",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:fast": "npm run check:v5-api-generated && vite build",
    "preview": "vite preview",
    "generate:v5-api": "node ../../scripts/generate_kronos_v5_api_types.mjs",
    "check:v5-api-generated": "node ../../scripts/generate_kronos_v5_api_types.mjs --check",
    "check": "npm run check:v5-api-generated && svelte-check --tsconfig ./tsconfig.json",
    "test:v5-api": "bun test src/lib/api.test.ts src/lib/generated/kronosRlApiV2.test.ts",
    "test": "bun test src"
  },
  "dependencies": {
    "canonicalize": "2.1.0",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "marked": "^18.0.3"
  },
  "devDependencies": {
    "@noble/ed25519": "2.2.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^20.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "^10.4.20",
    "json-schema-to-typescript": "15.0.4",
    "postcss": "^8.4.49",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.15",
    "tslib": "^2.8.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.6"
  }
}
